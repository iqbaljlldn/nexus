# ==============================================================================
# nexus Docker Compose Environment Template
# ==============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexus

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# API - Database Connection
NEXUS_API_DB_HOST=postgres
NEXUS_API_DB_PORT=5432
NEXUS_API_DB_USER=postgres
NEXUS_API_DB_PASSWORD=postgres
NEXUS_API_DB_NAME=nexus
NEXUS_API_DB_SSLMODE=disable

# API - Redis Connection
NEXUS_API_REDIS_HOST=redis
NEXUS_API_REDIS_PORT=6379
NEXUS_API_REDIS_PASSWORD=

# API - Object Storage (MinIO)
NEXUS_API_STORAGE_ENDPOINT=minio:9000
NEXUS_API_STORAGE_ACCESS_KEY=minioadmin
NEXUS_API_STORAGE_SECRET_KEY=minioadmin
NEXUS_API_STORAGE_USE_SSL=false
NEXUS_API_STORAGE_REGION=us-east-1

# API - Server
NEXUS_API_PORT=8080
NEXUS_API_ENV=development
