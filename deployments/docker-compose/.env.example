# ==============================================================================
# nexus Docker Compose Environment Template
# ==============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexus

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# API - Database Connection
NEXUS_API_DB_URL=postgres://postgres:postgres@postgres:5432/nexus?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/nexus?sslmode=disable


# API - Redis Connection
NEXUS_API_REDIS_URL=redis://redis:6379/0

# API - Object Storage (MinIO)
NEXUS_API_STORAGE_ENDPOINT=minio:9000
NEXUS_API_STORAGE_ACCESS_KEY=minioadmin
NEXUS_API_STORAGE_SECRET_KEY=minioadmin
NEXUS_API_STORAGE_USE_SSL=false
NEXUS_API_STORAGE_REGION=us-east-1

# API - Server
NEXUS_API_PORT=8080
NEXUS_API_ENV=development
BASE_URL=http://localhost:3000

